# Microsoft Graph credentials used by the existing `pnpm auth` setup flow.
CLIENT_ID=your_azure_app_client_id
CLIENT_SECRET=your_azure_app_client_secret
TENANT_ID=organizations
REDIRECT_URI=http://localhost:3000/callback

# Remote MCP server. MCP_PUBLIC_URL is the public HTTPS origin, without /mcp.
MCP_PUBLIC_URL=https://todo.example.com
MCP_OAUTH_PASSWORD=replace-with-a-long-random-password
MCP_HOST=127.0.0.1
MCP_PORT=3001

# Set to the number of trusted reverse proxies in front of this process.
MCP_TRUST_PROXY=1

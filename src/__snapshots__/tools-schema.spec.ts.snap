[
  {
    "description": "Move completed tasks older than a specified number of days from one list to another (archive) list. Useful for cleaning up active lists while preserving historical tasks.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dryRun": {
          "default": false,
          "description": "If true, only preview what would be archived without making changes",
          "type": "boolean",
        },
        "olderThanDays": {
          "default": 90,
          "description": "Archive tasks completed more than this many days ago (default: 90)",
          "minimum": 0,
          "type": "number",
        },
        "sourceListId": {
          "description": "ID of the source list to archive tasks from",
          "type": "string",
        },
        "targetListId": {
          "description": "ID of the target archive list",
          "type": "string",
        },
      },
      "required": [
        "sourceListId",
        "targetListId",
      ],
      "type": "object",
    },
    "name": "archive-completed-tasks",
  },
  {
    "description": "Check if you're authenticated with Microsoft Graph API. Shows current token status and expiration time, and indicates if the token needs to be refreshed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "auth-status",
  },
  {
    "description": "Create a new checklist item (subtask) for a task. Checklist items help break down a task into smaller, manageable steps.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "displayName": {
          "description": "Text content of the checklist item",
          "type": "string",
        },
        "isChecked": {
          "description": "Whether the item is checked off",
          "type": "boolean",
        },
        "listId": {
          "description": "ID of the task list",
          "type": "string",
        },
        "taskId": {
          "description": "ID of the task",
          "type": "string",
        },
      },
      "required": [
        "listId",
        "taskId",
        "displayName",
      ],
      "type": "object",
    },
    "name": "create-checklist-item",
  },
  {
    "description": "Create a new task in a specific Microsoft Todo list. A task is the main todo item that can have a title, description, due date, and other properties. Pass \`recurrence\` to make the task repeat (e.g. monthly bill payments, birthdays, weekly reviews).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "body": {
          "description": "Description or body content of the task",
          "type": "string",
        },
        "categories": {
          "description": "Categories associated with the task",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "dueDateTime": {
          "description": "Due date in ISO format (e.g., 2023-12-31T23:59:59Z)",
          "type": "string",
        },
        "importance": {
          "description": "Task importance",
          "enum": [
            "low",
            "normal",
            "high",
          ],
          "type": "string",
        },
        "isReminderOn": {
          "description": "Whether to enable reminder for this task",
          "type": "boolean",
        },
        "listId": {
          "description": "ID of the task list",
          "type": "string",
        },
        "recurrence": {
          "description": "Recurrence rule. Omit for a one-off task. Requires \`dueDateTime\` to be set (the recurrence derives its first occurrence from it).",
          "properties": {
            "pattern": {
              "properties": {
                "dayOfMonth": {
                  "description": "Day of month for absoluteMonthly / absoluteYearly.",
                  "maximum": 31,
                  "minimum": 1,
                  "type": "integer",
                },
                "daysOfWeek": {
                  "description": "Days of week for weekly / relativeMonthly / relativeYearly.",
                  "items": {
                    "enum": [
                      "sunday",
                      "monday",
                      "tuesday",
                      "wednesday",
                      "thursday",
                      "friday",
                      "saturday",
                    ],
                    "type": "string",
                  },
                  "type": "array",
                },
                "firstDayOfWeek": {
                  "description": "Which day is the start of the week (defaults to sunday).",
                  "enum": [
                    "sunday",
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                  ],
                  "type": "string",
                },
                "index": {
                  "description": "Ordinal position for relativeMonthly / relativeYearly (e.g. 'second' Tuesday).",
                  "enum": [
                    "first",
                    "second",
                    "third",
                    "fourth",
                    "last",
                  ],
                  "type": "string",
                },
                "interval": {
                  "description": "How often the pattern repeats (1 = every period, 2 = every second, ...).",
                  "maximum": 255,
                  "minimum": 1,
                  "type": "integer",
                },
                "month": {
                  "description": "Month for absoluteYearly / relativeYearly (1-12).",
                  "maximum": 12,
                  "minimum": 1,
                  "type": "integer",
                },
                "type": {
                  "description": "Recurrence pattern type. daily | weekly | absoluteMonthly (e.g. 15th of every N months) | relativeMonthly (e.g. 2nd Tuesday of every N months) | absoluteYearly | relativeYearly.",
                  "enum": [
                    "daily",
                    "weekly",
                    "absoluteMonthly",
                    "relativeMonthly",
                    "absoluteYearly",
                    "relativeYearly",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "type",
                "interval",
              ],
              "type": "object",
            },
            "range": {
              "properties": {
                "endDate": {
                  "description": "Required when type=endDate; ISO date YYYY-MM-DD.",
                  "type": "string",
                },
                "numberOfOccurrences": {
                  "description": "Required when type=numbered; how many occurrences before stopping.",
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer",
                },
                "recurrenceTimeZone": {
                  "description": "IANA timezone for the recurrence. In one live test Microsoft To Do stored 'Asia/Kolkata' as UTC, and it keeps only the due date's day, not its time.",
                  "type": "string",
                },
                "startDate": {
                  "description": "Required for endDate/numbered; ISO date YYYY-MM-DD. Defaults to the task due date if omitted.",
                  "type": "string",
                },
                "type": {
                  "description": "How long the recurrence repeats: endDate (stops at endDate), noEnd (forever), numbered (stops after N occurrences).",
                  "enum": [
                    "endDate",
                    "noEnd",
                    "numbered",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
          },
          "required": [
            "pattern",
            "range",
          ],
          "type": "object",
        },
        "reminderDateTime": {
          "description": "Reminder date and time in ISO format",
          "type": "string",
        },
        "startDateTime": {
          "description": "Start date in ISO format (e.g., 2023-12-31T23:59:59Z)",
          "type": "string",
        },
        "status": {
          "description": "Status of the task",
          "enum": [
            "notStarted",
            "inProgress",
            "completed",
            "waitingOnOthers",
            "deferred",
          ],
          "type": "string",
        },
        "title": {
          "description": "Title of the task",
          "type": "string",
        },
      },
      "required": [
        "listId",
        "title",
      ],
      "type": "object",
    },
    "name": "create-task",
  },
